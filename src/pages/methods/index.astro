---
import { methods } from "../../lib/methods";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Explore calculation methods and frameworks planned for the Digital Carbon Footprint Platform." />
    <meta name="theme-color" content="#151a19" />
    <title>Method Library · Digital Carbon Footprint Platform</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar"><a class="brand" href="/">DCFP<span>.</span></a><a href="/">Home</a></header>
      <section class="intro">
        <p class="eyebrow">DCFP KNOWLEDGE BASE</p>
        <h1>Method library</h1>
        <p class="lead">Each methodology has its own scope, assumptions, inputs, and calculation rules. DCFP keeps them separate so results are not silently mixed or presented as directly comparable.</p>
      </section>
      <section class="list">
        {methods.map((method, index) => (
          <a class="item" href={`/methods/${method.slug}/`}>
            <span class="number">0{index + 1}</span>
            <span class="body"><strong>{method.name}</strong><small>{method.summary}</small></span>
            <span class="tag">{method.statusLabel}</span>
            <span class="arrow">↗</span>
          </a>
        ))}
      </section>
      <p class="footnote">A method appearing in this library does not mean it has been implemented. Check each method profile for its current status.</p>
      <footer>Digital Carbon Footprint Platform · Open-source project in development</footer>
    </main>
  </body>
</html>

<style>
  :global(*){box-sizing:border-box}
  :global(html){background:#151a19;color:#e9eeeb;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  :global(body){margin:0}
  .shell{max-width:1040px;margin:auto;padding:32px 28px 48px}
  .topbar{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #303936;padding-bottom:22px}
  .brand{font-size:22px;font-weight:800;letter-spacing:-1px;color:#f2f5f3;text-decoration:none}
  .brand span{color:#79b99b}
  .topbar>a:last-child{color:#a8cdb7;text-decoration:none;font-size:13px}
  .intro{padding:75px 0 45px;max-width:760px}
  .eyebrow{font-size:10px;letter-spacing:1.5px;font-weight:700;color:#82c5a2}
  h1{font-size:clamp(40px,6vw,62px);letter-spacing:-2px;margin:15px 0}
  .lead{font-size:17px;line-height:1.7;color:#aeb9b3}
  .list{border-top:1px solid #35403a}
  .item{display:grid;grid-template-columns:38px minmax(0,1fr) auto 16px;gap:16px;align-items:center;padding:23px 4px;border-bottom:1px solid #35403a;text-decoration:none;color:inherit}
  .number{font-size:12px;color:#718078}
  .body strong{display:block;font-size:16px;margin-bottom:6px}
  .body small{display:block;font-size:13px;line-height:1.5;color:#9daaa3}
  .tag{font-size:10px;letter-spacing:.4px;color:#b6c1bb;border:1px solid #46534c;border-radius:20px;padding:7px 10px;white-space:nowrap}
  .arrow{color:#86c7a5}
  .item:hover .body strong{color:#9bc9ae}
  .footnote{margin:24px 0 60px;color:#89968f;font-size:12px;line-height:1.7}
  footer{border-top:1px solid #303936;padding-top:20px;color:#89968f;font-size:12px}
  @media(max-width:680px){.shell{padding:22px 18px}.intro{padding:55px 0 30px}.item{grid-template-columns:25px minmax(0,1fr) 16px;gap:10px}.tag{grid-column:2;justify-self:start;grid-row:2}.arrow{grid-column:3;grid-row:1}.body{grid-column:2}.number{grid-column:1;grid-row:1}}
</style>
