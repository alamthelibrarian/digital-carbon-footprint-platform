---
import { methods } from "../lib/methods";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An open-source, multi-method platform for digital carbon footprint calculation, analysis, and reporting." />
    <meta name="theme-color" content="#151a19" />
    <title>Digital Carbon Footprint Platform</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar"><a class="brand" href="/">DCFP<span>.</span></a><span class="status">OPEN SOURCE · IN DEVELOPMENT</span></header>
      <section class="intro">
        <p class="eyebrow">DIGITAL SUSTAINABILITY TOOLKIT</p>
        <h1>Understand the carbon footprint of <em>digital activity.</em></h1>
        <p class="lead">A modular, open-source platform for digital carbon footprint calculation, analysis, and reporting — built around transparent methods, traceable data, and explicit assumptions.</p>
        <div class="actions"><a class="repo" href="/methods/">Browse method library ↗</a><a class="repo secondary" href="https://github.com/alamthelibrarian/digital-carbon-footprint-platform">Explore the project on GitHub ↗</a></div>
      </section>
      <section class="methods">
        <div class="section-head"><div><p class="eyebrow">METHOD LIBRARY</p><h2>Calculation methods</h2></div><a class="count" href="/methods/">VIEW ALL METHODS ↗</a></div>
        <div class="method-list">
          {methods.map((method, i) => <article class="method"><span class="number">0{i + 1}</span><div><h3><a href={`/methods/${method.slug}/`}>{method.name}</a></h3><p>{method.summary}</p></div><span class="tag">{method.statusLabel}</span></article>)}
        </div>
      </section>
      <footer><p>Independent software implementation. The initial method is based on the Digital Preservation Coalition (DPC) Carbon Footprint Toolkit v1.0; this project is not an official DPC product or endorsed by DPC.</p><a href="https://doi.org/10.7207/carbonfootprinttoolkit26-01">DPC source publication ↗</a></footer>
    </main>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box} :global(html){background:#151a19;color:#e9eeeb;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif} :global(body){margin:0}.shell{max-width:1040px;margin:auto;padding:32px 28px 48px}.topbar{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #303936;padding-bottom:22px}.brand{font-size:22px;font-weight:800;letter-spacing:-1px;color:#f2f5f3;text-decoration:none}.brand span{color:#79b99b}.status,.eyebrow,.count,.tag{font-size:10px;letter-spacing:1.5px;font-weight:700;color:#8e9b95}.intro{padding:100px 0 90px;max-width:760px}.eyebrow{color:#82c5a2}.intro h1{font-size:clamp(42px,7vw,72px);line-height:1.04;letter-spacing:-3px;margin:20px 0 24px;font-weight:650}.intro h1 em{font-style:normal;color:#86c7a5}.lead{font-size:18px;line-height:1.7;color:#aeb9b3;max-width:680px}.actions{display:flex;gap:26px;flex-wrap:wrap}.repo{display:inline-block;margin-top:25px;color:#dce9e1;text-decoration:none;border-bottom:1px solid #6a9f82;padding-bottom:7px;font-size:14px}.repo.secondary{color:#9daaa3;border-bottom-color:#46534c}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:18px}.section-head h2{font-size:26px;margin:8px 0 0;letter-spacing:-.8px}.method-list{border-top:1px solid #35403a}.method{display:grid;grid-template-columns:44px 1fr auto;gap:16px;align-items:center;padding:22px 4px;border-bottom:1px solid #35403a}.number{color:#718078;font-size:12px}.method h3{font-size:16px;margin:0 0 6px}.method p{font-size:13px;color:#9daaa3;margin:0}.tag{border:1px solid #46534c;border-radius:20px;padding:7px 10px;letter-spacing:.5px;white-space:nowrap}.tag.listed{color:#91d0ad;border-color:#527d65}footer{margin-top:70px;padding-top:20px;border-top:1px solid #303936;color:#89968f;font-size:12px;line-height:1.7}footer a{color:#9bc9ae;text-decoration:none}@media(max-width:600px){.shell{padding:22px 18px}.intro{padding:76px 0 65px}.intro h1{letter-spacing:-2px}.section-head{align-items:start;gap:12px;flex-direction:column}.method{grid-template-columns:28px 1fr;gap:10px}.tag{grid-column:2;justify-self:start}.status{font-size:8px;letter-spacing:.8px}}
</style>
