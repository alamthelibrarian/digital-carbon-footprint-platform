---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Estimate digital preservation emissions with the DPC Carbon Footprint Toolkit v1.0 calculation engine." />
    <meta name="theme-color" content="#151a19" />
    <title>DPC v1.0 Calculator · DCFP</title>
  </head>
  <body>
    <main class="shell">
      <header class="top"><a href="/" class="brand">DCFP<span>.</span></a><a href="/methods/dpc-v1/">Method notes ↗</a></header>
      <section class="heading">
        <p class="eyebrow">CALCULATION WORKSPACE · METHOD 01</p>
        <h1>DPC Carbon Footprint Toolkit <em>v1.0</em></h1>
        <p>Enter activity data and the emission factors you have selected. Every factor must be accompanied by its source; this calculator does not silently supply country defaults.</p>
        <div class="notice"><strong>Development preview — not validated.</strong> This independent implementation is based on the DPC Carbon Footprint Toolkit v1.0. Results are indicative only and must not be used for formal reporting, compliance, or audited disclosure. Embodied carbon is not included.</div>
      </section>

      <form id="calculator">
        <section class="panel">
          <div class="panel-head"><div><p class="eyebrow">INVENTORY METADATA</p><h2>Assessment details</h2><p class="hint">Complete the assessment scope and reporting period. Only categories you enable will be included in the calculation.</p></div></div>
          <div class="fields">
            <label>Assessment / inventory name<input name="inventoryName" /></label>
            <label>Organization / unit<input name="organization" placeholder="Organization or department" /></label>
            <label>Assessment subject<input name="subject" placeholder="What system, service, or activity is being assessed" required /></label>
            <label>System boundary<input name="systemBoundary" placeholder="Describe included activities, infrastructure, and exclusions" required /></label>
            <label>Functional unit<input name="functionalUnit" placeholder="e.g. annual operation of the digital repository" required /></label>
            <label>Reporting period<input name="reportingPeriod" placeholder="e.g. 1 January–31 December 2025" required /></label>
            <label>Geography<input name="geography" placeholder="Country, region, or site" /></label>
            <label>Prepared by<input name="preparedBy" placeholder="Name or role (optional)" /></label>
            <label>Period start<input name="periodStart" type="date" /></label>
            <label>Period end<input name="periodEnd" type="date" /></label>
          </div>
        </section>
        <section class="panel">
          <div class="panel-head"><div><p class="eyebrow">01 / INFRASTRUCTURE</p><h2>On-premise equipment</h2></div><label class="toggle"><input type="checkbox" name="onEnabled" /> Include</label></div>
          <div class="fields">
            <label>Activity category<select name="onCategory"><option value="acquisition-transfer-ingest">Acquisition, transfer & ingest</option><option value="bitstream-preservation">Bitstream preservation</option><option value="content-preservation">Content preservation</option><option value="metadata-management">Metadata management</option><option value="discovery-access">Discovery & access</option></select></label>
            <label>Machine / equipment name<input name="machineName" /></label>
            <label>Idle power (W)<input name="idlePowerW" type="number" min="0" step="any" /></label>
            <label>Maximum power (W)<input name="maxPowerW" type="number" min="0" step="any" /></label>
            <label>Mean utilisation (0–1)<input name="meanUtilisation" type="number" min="0" max="1" step="any" /></label>
            <label>Storage capacity (TB)<input name="storageCapacityTB" type="number" min="0" step="any" /></label>
            <label>Storage intensity (Wh/TB/hour)<input name="storageEnergyWhPerTBh" type="number" min="0" step="any" /></label>
            <label>PUE<input name="pue" type="number" min="0.000001" step="any" /></label>
            <label>Grid factor (kgCO₂e/kWh)<input name="gridFactorKgCO2ePerKWh" type="number" min="0" step="any" /></label>
            <label>Grid factor source<input name="gridFactorSource" /></label>
            <label>Grid factor source type<select name="onFactorDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Grid factor geography<input name="onFactorGeography" placeholder="Country / region / grid zone" /></label>
            <label>Grid factor reference year<input name="onFactorYear" type="number" min="1900" max="2100" placeholder="e.g. 2025" /></label>
            <label>Activity data source<input name="onSource" /></label>
            <label>Data confidence<select name="onConfidence"><option value="" selected disabled>Select confidence</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head"><div><p class="eyebrow">02 / CLOUD SERVICES</p><h2>Cloud-hosted services</h2><p class="hint">Use annual emissions supplied by a provider or a documented external calculation.</p></div><label class="toggle"><input type="checkbox" name="cloudEnabled" /> Include</label></div>
          <div class="fields">
            <label>Data centres / servers (kgCO₂e/year)<input name="cloudServerKg" type="number" min="0" step="any" /></label>
            <label>Service name<input name="cloudServerName" /></label>
            <label>Source<input name="cloudServerSource" /></label>
            <label>Server emissions source type<select name="cloudServerDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Networking (kgCO₂e/year)<input name="cloudNetworkKg" type="number" min="0" step="any" /></label>
            <label>Networking service name<input name="cloudNetworkName" /></label>
            <label>Source<input name="cloudNetworkSource" /></label>
            <label>Cloud networking source type<select name="cloudNetworkDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Provider data geography<input name="cloudFactorGeography" placeholder="Provider region / country" /></label>
            <label>Provider data reference year<input name="cloudFactorYear" type="number" min="1900" max="2100" placeholder="e.g. 2025" /></label>
            <label>Data confidence<select name="cloudConfidence"><option value="" selected disabled>Select confidence</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head"><div><p class="eyebrow">03 / NETWORKING</p><h2>On-premise data transfer</h2></div><label class="toggle"><input type="checkbox" name="networkEnabled" /> Include</label></div>
          <div class="fields">
            <label>Activity category<select name="networkCategory"><option value="acquisition-transfer-ingest">Acquisition, transfer & ingest</option><option value="bitstream-preservation">Bitstream preservation</option><option value="content-preservation">Content preservation</option><option value="metadata-management">Metadata management</option><option value="discovery-access">Discovery & access</option></select></label>
            <label>Activity name<input name="networkName" /></label>
            <label>Transmitted data (MB/day)<input name="transmittedMBPerDay" type="number" min="0" step="any" /></label>
            <label>Received data (MB/day)<input name="receivedMBPerDay" type="number" min="0" step="any" /></label>
            <label>Network intensity (kWh/GB)<input name="networkIntensity" type="number" min="0" step="any" /></label>
            <label>Grid factor (kgCO₂e/kWh)<input name="networkGridFactor" type="number" min="0" step="any" /></label>
            <label>Grid factor source<input name="networkGridSource" /></label>
            <label>Grid factor source type<select name="networkGridDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Grid factor geography<input name="networkFactorGeography" placeholder="Country / region / grid zone" /></label>
            <label>Grid factor reference year<input name="networkFactorYear" type="number" min="1900" max="2100" placeholder="e.g. 2025" /></label>
            <label>Network intensity factor source<input name="networkIntensitySource" placeholder="Source for kWh/GB factor" /></label>
            <label>Network intensity source type<select name="networkIntensityDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Network intensity reference year<input name="networkIntensityYear" type="number" min="1900" max="2100" placeholder="e.g. 2025" /></label>
            <label>Activity data source<input name="networkSource" /></label>
            <label>Data confidence<select name="networkConfidence"><option value="" selected disabled>Select confidence</option><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head"><div><p class="eyebrow">04 / WEBSITE</p><h2>Website use</h2><p class="hint">The engine uses the midpoint of fixed-line and mobile energy-intensity inputs.</p></div><label class="toggle"><input type="checkbox" name="websiteEnabled" /> Include</label></div>
          <div class="fields">
            <label>Average page size (KB)<input name="pageSizeKB" type="number" min="0" step="any" /></label>
            <label>Annual visits<input name="annualVisits" type="number" min="0" step="any" /></label>
            <label>Average download size (MB)<input name="downloadSizeMB" type="number" min="0" step="any" /></label>
            <label>Annual downloads<input name="annualDownloads" type="number" min="0" step="any" /></label>
            <label>Fixed-line intensity (kWh/GB)<input name="fixedIntensity" type="number" min="0" step="any" /></label>
            <label>Mobile intensity (kWh/GB)<input name="mobileIntensity" type="number" min="0" step="any" /></label>
            <label>Fixed-line factor source<input name="fixedSource" /></label>
            <label>Fixed-line source type<select name="fixedDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Mobile factor source<input name="mobileSource" /></label>
            <label>Mobile source type<select name="mobileDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Mean grid factor (kgCO₂e/kWh)<input name="websiteGridFactor" type="number" min="0" step="any" /></label>
            <label>Grid factor source<input name="websiteGridSource" /></label>
            <label>Website grid source type<select name="websiteGridDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Factor geography<input name="websiteFactorGeography" placeholder="Global / country / region" /></label>
            <label>Factor reference year<input name="websiteFactorYear" type="number" min="1900" max="2100" placeholder="e.g. 2025" /></label>
          </div>
        </section>

        <section class="panel">
          <div class="panel-head"><div><p class="eyebrow">05 / TRAVEL</p><h2>Travel emissions</h2><p class="hint">Enter a total from a documented travel emissions source, in kilograms CO₂e.</p></div><label class="toggle"><input type="checkbox" name="travelEnabled" /> Include</label></div>
          <div class="fields">
            <label>Travel description<input name="travelDescription" /></label>
            <label>Emissions (kgCO₂e)<input name="travelKg" type="number" min="0" step="any" /></label>
            <label>Source<input name="travelSource" /></label>
            <label>Travel source type<select name="travelDataKind"><option value="">Not specified</option><option value="measured">Measured</option><option value="provider-reported">Provider-reported</option><option value="secondary-literature">Secondary literature</option><option value="proxy">Proxy</option></select></label>
            <label>Source geography<input name="travelGeography" placeholder="Country / region" /></label>
            <label>Source reference year<input name="travelYear" type="number" min="1900" max="2100" placeholder="e.g. 2025" /></label>
          </div>
        </section>
        <div class="submit-row"><p>No activity or emission-factor values are prefilled. Enter evidence from your own inventory; illustrative values must not be treated as measured data.</p><button type="submit">Calculate footprint ↗</button></div>
      </form>

      <section id="results" class="results" hidden aria-live="polite">
        <header class="report-header">
          <div><p class="eyebrow">DIGITAL CARBON FOOTPRINT PLATFORM · DPC V1.0</p><h2 id="report-title">Assessment report</h2><p id="report-subject" class="report-subject"></p></div>
          <span class="report-status">DEVELOPMENT PREVIEW · NOT VALIDATED</span>
        </header>
        <div class="report-meta" id="report-meta"></div>
        <section class="report-total"><p class="eyebrow">TOTAL ESTIMATED EMISSIONS</p><p id="total" class="total">—</p><span class="unit">kgCO₂e · DPC native aggregate</span><p class="quality-status">Displayed values are rounded to three decimal places for readability. Rounding is not an uncertainty estimate; the underlying calculation values remain in the JSON record.</p></section>
        <section class="report-section"><h3>Emissions by category</h3><p class="hint">Contribution is calculated against the native DPC total. Percentages are omitted when the total is zero.</p><div id="breakdown" class="breakdown"></div></section>
        <section class="report-section"><h3>Activity-data confidence</h3><p class="quality-status">Confidence levels below describe the activity data supplied for each calculation row. They are self-assessments and are not independent verification.</p><div id="activity-confidence" class="provenance-list"></div></section>
        <section class="report-section"><h3>Emission-factor provenance</h3><p id="provenance-status" class="quality-status"></p><div id="provenance" class="provenance-list"></div><p class="quality-status">Source type (measured, provider-reported, secondary literature, or proxy) is a user-supplied classification, not a quality score. Emission-factor quality is not independently assessed in this development preview. A recorded source does not establish its authority, geographic or temporal suitability, or scientific validity.</p></section>
        <section class="report-section"><h3>Assumptions</h3><ul id="assumptions" class="report-list"></ul></section>
        <section class="report-section"><h3>Limitations</h3><ul id="limitations" class="report-list"></ul></section>
        <details class="technical-details"><summary>Complete calculation record (JSON)</summary><pre id="details"></pre></details>
        <p class="report-footnote">This is an indicative development preview, not a validated assessment. It must not be used for formal reporting, compliance, or audited disclosure. Embodied carbon is not included. Review the method notes and verify all activity data and factor sources before interpreting this result.</p>
        <div class="result-actions"><button id="download" class="download" type="button">Download JSON record</button><button id="print" class="print" type="button">Print / Save as PDF</button></div>
      </section>
      <p id="error" class="error" role="alert"></p>
      <footer><p>Independent software implementation based on the <a href="https://doi.org/10.7207/carbonfootprinttoolkit26-01">DPC Carbon Footprint Toolkit v1.0</a>. Not an official DPC product and not endorsed by DPC. See the <a href="/methods/dpc-v1/">method notes</a> and <a href="https://github.com/alamthelibrarian/digital-carbon-footprint-platform">source code</a>.</p></footer>
    </main>
  </body>
</html>
<script>
  import { calculateDpcV1 } from "../../../engines/dpc-v1/index";
  import { adaptDpcV1Result } from "../../../engines/dpc-v1/result-adapter";
  import { buildDpcV1ReportBreakdown } from "../../../engines/dpc-v1/report-view";

  const form = document.querySelector<HTMLFormElement>("#calculator")!;
  const results = document.querySelector<HTMLElement>("#results")!;
  const error = document.querySelector<HTMLElement>("#error")!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const value = (name: string): string => field(name).value.trim();
  const requiredText = (name: string, label: string): string => {
    const current = value(name);
    if (!current) throw new TypeError(`${label} is required for an included category.`);
    return current;
  };
  const number = (name: string): number => {
    const raw = value(name);
    if (!raw) throw new TypeError(`${field(name).labels?.[0]?.textContent?.trim() || name} is required.`);
    const parsed = Number(raw);
    if (!Number.isFinite(parsed) || parsed < 0) {
      throw new RangeError(`${name} must be a finite, non-negative number.`);
    }
    return parsed;
  };
  const enabled = (name: string): boolean => field(name).checked;
  const format = (n: number): string => new Intl.NumberFormat("en-US", { maximumFractionDigits: 3 }).format(n);
  let latestRecord: Record<string, any> | null = null;

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    error.textContent = "";
    try {
      const periodStart = value("periodStart");
      const periodEnd = value("periodEnd");
      if (Boolean(periodStart) !== Boolean(periodEnd)) {
        throw new TypeError("Enter both assessment period start and end dates, or leave both blank.");
      }
      if (periodStart && periodEnd && periodEnd < periodStart) {
        throw new RangeError("Assessment period end must be on or after the start date.");
      }
      requiredText("subject", "Assessment subject");
      requiredText("systemBoundary", "System boundary");
      requiredText("functionalUnit", "Functional unit");
      requiredText("reportingPeriod", "Reporting period");
      const metadata = {
        assessmentName: value("inventoryName"),
        organization: value("organization") || null,
        geography: value("geography") || null,
        preparedBy: value("preparedBy") || null,
        periodStart: periodStart || null,
        periodEnd: periodEnd || null
      };
      const input: any = {};
      if (enabled("onEnabled")) {
        requiredText("machineName", "Machine / equipment name");
        requiredText("gridFactorSource", "On-premise grid factor source");
        requiredText("onSource", "On-premise activity data source");
        requiredText("onConfidence", "On-premise data confidence");
        input.onPremise = [{
        category: value("onCategory"), machineName: value("machineName"),
        idlePowerW: number("idlePowerW"), maxPowerW: number("maxPowerW"),
        meanUtilisation: number("meanUtilisation"), storageCapacityTB: number("storageCapacityTB"),
        storageEnergyWhPerTBh: number("storageEnergyWhPerTBh"), pue: number("pue"),
        gridFactorKgCO2ePerKWh: number("gridFactorKgCO2ePerKWh"),
        gridFactorSource: value("gridFactorSource"), source: value("onSource"),
        confidence: value("onConfidence"),
        factorProvenance: { factor: "electricity-grid", value: number("gridFactorKgCO2ePerKWh"), unit: "kgCO2e/kWh", source: value("gridFactorSource"), geography: value("onFactorGeography") || null, referenceYear: value("onFactorYear") ? number("onFactorYear") : null, ...(value("onFactorDataKind") ? { dataKind: value("onFactorDataKind") } : {}) }
        }];
      }
      if (enabled("cloudEnabled")) {
        requiredText("cloudServerName", "Cloud data-centre / server service name");
        requiredText("cloudServerSource", "Cloud data-centre / server source");
        requiredText("cloudNetworkName", "Cloud networking service name");
        requiredText("cloudNetworkSource", "Cloud networking source");
        requiredText("cloudConfidence", "Cloud data confidence");
        input.cloud = [
        { category: "data-centres-servers", serviceName: value("cloudServerName"), annualEmissionsKgCO2e: number("cloudServerKg"), source: value("cloudServerSource"), confidence: value("cloudConfidence"), factorProvenance: { factor: "provider-reported-emissions", value: number("cloudServerKg"), unit: "kgCO2e/year", source: value("cloudServerSource"), geography: value("cloudFactorGeography") || null, referenceYear: value("cloudFactorYear") ? number("cloudFactorYear") : null, ...(value("cloudServerDataKind") ? { dataKind: value("cloudServerDataKind") } : {}) } },
        { category: "networking", serviceName: value("cloudNetworkName"), annualEmissionsKgCO2e: number("cloudNetworkKg"), source: value("cloudNetworkSource"), confidence: value("cloudConfidence"), factorProvenance: { factor: "provider-reported-emissions", value: number("cloudNetworkKg"), unit: "kgCO2e/year", source: value("cloudNetworkSource"), geography: value("cloudFactorGeography") || null, referenceYear: value("cloudFactorYear") ? number("cloudFactorYear") : null, ...(value("cloudNetworkDataKind") ? { dataKind: value("cloudNetworkDataKind") } : {}) } }
        ];
      }
      if (enabled("networkEnabled")) {
        requiredText("networkName", "Networking activity name");
        requiredText("networkGridSource", "Networking grid factor source");
        requiredText("networkIntensitySource", "Network energy-intensity source");
        requiredText("networkSource", "Networking activity data source");
        requiredText("networkConfidence", "Networking data confidence");
        input.networking = [{
        category: value("networkCategory"), activityName: value("networkName"),
        transmittedMBPerDay: number("transmittedMBPerDay"), receivedMBPerDay: number("receivedMBPerDay"),
        networkEnergyIntensityKWhPerGB: number("networkIntensity"),
        gridFactorKgCO2ePerKWh: number("networkGridFactor"),
        gridFactorSource: value("networkGridSource"), source: value("networkSource"),
        confidence: value("networkConfidence"),
        factorProvenance: [
          { factor: "electricity-grid", value: number("networkGridFactor"), unit: "kgCO2e/kWh", source: value("networkGridSource"), geography: value("networkFactorGeography") || null, referenceYear: value("networkFactorYear") ? number("networkFactorYear") : null, ...(value("networkGridDataKind") ? { dataKind: value("networkGridDataKind") } : {}) },
          { factor: "network-energy-intensity", value: number("networkIntensity"), unit: "kWh/GB", source: value("networkIntensitySource") || null, referenceYear: value("networkIntensityYear") ? number("networkIntensityYear") : null, ...(value("networkIntensityDataKind") ? { dataKind: value("networkIntensityDataKind") } : {}) }
        ]
        }];
      }
      if (enabled("websiteEnabled")) {
        requiredText("fixedSource", "Fixed-line intensity source");
        requiredText("mobileSource", "Mobile intensity source");
        requiredText("websiteGridSource", "Website grid factor source");
        input.websiteUse = {
        averagePageSizeKB: number("pageSizeKB"), annualVisits: number("annualVisits"),
        averageDownloadSizeMB: number("downloadSizeMB"), annualDownloads: number("annualDownloads"),
        fixedLineIntensityKWhPerGB: number("fixedIntensity"), mobileIntensityKWhPerGB: number("mobileIntensity"),
        fixedLineIntensitySource: value("fixedSource"), mobileIntensitySource: value("mobileSource"),
        meanGlobalGridFactorKgCO2ePerKWh: number("websiteGridFactor"), gridFactorSource: value("websiteGridSource"),
        factorProvenance: [
          { factor: "fixed-line-network-intensity", value: number("fixedIntensity"), unit: "kWh/GB", source: value("fixedSource"), geography: value("websiteFactorGeography") || null, referenceYear: value("websiteFactorYear") ? number("websiteFactorYear") : null, ...(value("fixedDataKind") ? { dataKind: value("fixedDataKind") } : {}) },
          { factor: "mobile-network-intensity", value: number("mobileIntensity"), unit: "kWh/GB", source: value("mobileSource"), geography: value("websiteFactorGeography") || null, referenceYear: value("websiteFactorYear") ? number("websiteFactorYear") : null, ...(value("mobileDataKind") ? { dataKind: value("mobileDataKind") } : {}) },
          { factor: "mean-global-grid", value: number("websiteGridFactor"), unit: "kgCO2e/kWh", source: value("websiteGridSource"), geography: value("websiteFactorGeography") || null, referenceYear: value("websiteFactorYear") ? number("websiteFactorYear") : null, ...(value("websiteGridDataKind") ? { dataKind: value("websiteGridDataKind") } : {}) }
        ]
        };
      }
      if (enabled("travelEnabled")) {
        requiredText("travelDescription", "Travel description");
        requiredText("travelSource", "Travel emissions source");
        input.travel = [{
        description: value("travelDescription"), emissionsKgCO2e: number("travelKg"), source: value("travelSource"),
        factorProvenance: { factor: "travel-emissions-calculation", value: number("travelKg"), unit: "kgCO2e", source: value("travelSource"), geography: value("travelGeography") || null, referenceYear: value("travelYear") ? number("travelYear") : null, ...(value("travelDataKind") ? { dataKind: value("travelDataKind") } : {}) }
        }];
      }

      if (!Object.keys(input).length) {
        throw new TypeError("Enable at least one activity category before calculating.");
      }
      const result = calculateDpcV1(input);
      const createdAt = new Date().toISOString();
      const envelope = adaptDpcV1Result(input, result, {
        id: crypto.randomUUID(),
        createdAt,
        ...(metadata.assessmentName ? { title: metadata.assessmentName } : {}),
        subject: value("subject"),
        systemBoundary: value("systemBoundary"),
        functionalUnit: value("functionalUnit"),
        reportingPeriod: value("reportingPeriod"),
        ...(metadata.geography ? { geography: metadata.geography } : {})
      });
      const reportBreakdown = buildDpcV1ReportBreakdown(envelope.results.metrics);
      const total = reportBreakdown.total.value;
      document.querySelector<HTMLElement>("#total")!.textContent = format(total);
      document.querySelector<HTMLElement>("#report-title")!.textContent = metadata.assessmentName || "DPC assessment report";
      document.querySelector<HTMLElement>("#report-subject")!.textContent = envelope.scope.subject;
      const meta = document.querySelector<HTMLElement>("#report-meta")!;
      const metaItems: Array<[string, string]> = [
        ["Organization / unit", metadata.organization || "Not specified"],
        ["System boundary", envelope.scope.systemBoundary],
        ["Functional unit", envelope.scope.functionalUnit],
        ["Reporting period", envelope.scope.reportingPeriod],
        ["Geography", envelope.scope.geography || "Not specified"],
        ["Prepared by", metadata.preparedBy || "Not specified"],
        ["DPC reference period", envelope.scope.referencePeriod],
        ["Assessment ID", envelope.assessment.id],
        ["Created (UTC)", envelope.assessment.createdAt],
        ["Method", `${envelope.method.name} v${envelope.method.version}`]
      ];
      meta.replaceChildren(...metaItems.map(([label, content]) => {
        const item = document.createElement("div"); item.className = "meta-item";
        const term = document.createElement("span"); term.textContent = label;
        const detail = document.createElement("strong"); detail.textContent = content;
        item.append(term, detail); return item;
      }));
      const rows = reportBreakdown.categories;
      const breakdown = document.querySelector<HTMLElement>("#breakdown")!;
      breakdown.replaceChildren(...rows.map((metric) => {
        const row = document.createElement("div"); row.className = "breakdown-item";
        const top = document.createElement("div"); top.className = "breakdown-row";
        const name = document.createElement("span"); name.textContent = metric.label;
        const figure = document.createElement("strong");
        const share = metric.sharePercent;
        figure.textContent = `${format(metric.value)} kgCO₂e${share === null ? "" : ` · ${format(share)}%`}`;
        top.append(name, figure);
        const track = document.createElement("div"); track.className = "bar-track";
        const bar = document.createElement("span"); bar.className = "bar-fill";
        bar.style.width = `${share === null ? 0 : Math.max(0, Math.min(100, share))}%`;
        track.append(bar); row.append(top, track); return row;
      }));
      const activityConfidence = document.querySelector<HTMLElement>("#activity-confidence")!;
      const confidenceEntries = envelope.dataQuality.activityConfidence;
      activityConfidence.replaceChildren(...confidenceEntries.map((confidence, index) => {
        const item = document.createElement("div"); item.className = "provenance-item";
        const label = document.createElement("strong"); label.textContent = "Activity-data confidence";
        const detail = document.createElement("span"); detail.textContent = confidence;
        item.append(label, detail); return item;
      }));
      const provenance = document.querySelector<HTMLElement>("#provenance")!;
      const coverage = envelope.dataQuality.factorProvenanceCoverage;
      document.querySelector<HTMLElement>("#provenance-status")!.textContent =
        `Provenance coverage: ${coverage}. This structural indicator only checks whether recorded factor entries include a source; it does not verify source quality or accuracy.`;
      provenance.replaceChildren(...envelope.factorProvenance.map((entry) => {
        const item = document.createElement("div"); item.className = "provenance-item";
        const location = document.createElement("strong"); location.textContent = entry.location;
        const source = document.createElement("span");
        const p = entry.provenance;
        source.textContent = [
          p.factor,
          p.value !== undefined ? `${p.value} ${p.unit}` : p.unit,
          p.source ? `Source: ${p.source}` : "Source: not recorded",
          `Geography: ${p.geography || "not recorded"}`,
          `Reference year: ${p.referenceYear ?? "not recorded"}`,
          `Source type: ${p.dataKind || "not specified"}`,
        ].filter(Boolean).join(" · ");
        item.append(location, source); return item;
      }));
      const renderList = (selector: string, entries: string[]) => {
        const list = document.querySelector<HTMLElement>(selector)!;
        list.replaceChildren(...entries.map((entry) => { const li = document.createElement("li"); li.textContent = entry; return li; }));
      };
      renderList("#assumptions", envelope.assumptions);
      renderList("#limitations", envelope.limitations);
      latestRecord = {
        platform: "Digital Carbon Footprint Platform",
        recordStatus: "development-preview-not-validated",
        report: envelope,
        sourceMetadata: metadata
      };
      document.querySelector<HTMLElement>("#details")!.textContent = JSON.stringify(latestRecord, null, 2);
      results.hidden = false;
      results.scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (exception) {
      results.hidden = true;
      error.textContent = exception instanceof Error ? exception.message : "Calculation failed. Check the input values.";
    }
  });
  document.querySelector<HTMLButtonElement>("#download")!.addEventListener("click", () => {
    if (!latestRecord) return;
    const safeName = (latestRecord.report.assessment.title || "dpc-assessment")
      .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "dpc-assessment";
    const blob = new Blob([JSON.stringify(latestRecord, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = safeName + "-dpc-v1-results.json";
    link.click();
    URL.revokeObjectURL(url);
  });
  document.querySelector<HTMLButtonElement>("#print")!.addEventListener("click", () => window.print());
</script>
